{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug-ninja",
      "displayName": "Debug-ninja",
      "inherits": "debug",
	  "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-vs",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-ninja",
      "displayName": "Release-ninja",
      "inherits": "release",
	  "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-vs",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}
