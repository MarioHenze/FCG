{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja",
      "inherits": "base",
      "displayName": "Ninja Multi-Config",
      "description": "Builds Debug and Release into a single tree, so an IDE's configuration switcher can flip between them without reconfiguring. Requires Ninja on PATH. Select the configuration with the ninja-debug / ninja-release build preset: a multi-config generator ignores CMAKE_BUILD_TYPE.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-ninja"
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug"},
    { "name": "release", "configurePreset": "release", "configuration": "Release"},
    { "name": "ninja-debug", "configurePreset": "ninja", "configuration": "Debug"},
    { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release"}
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "ninja-debug", "configurePreset": "ninja", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
